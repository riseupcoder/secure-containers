(block selinux-idea
    (blockinherit container)

    ;; process
    (allow process idea_data_t ( dir ( add_name create getattr open read remove_name rmdir search setattr write rename reparent watch ))) 

    (allow process idea_data_t ( file ( append create getattr ioctl lock map open read rename setattr unlink write watch ))) 

    (allow process idea_data_t (lnk_file ( create )))

    (allow process idea_data_t (file ( execute execute_no_trans )))
   
    (allow process idea_data_t (sock_file (create write unlink getattr)))

    ;; user_t
    (allow user_t idea_data_t ( dir ( add_name create getattr open read remove_name rmdir search setattr write rename ))) 

    (allow user_t idea_data_t ( file ( append create getattr ioctl open read rename setattr unlink write ))) 

    (allow user_t idea_data_t (lnk_file ( create setattr unlink getattr read )))

    ;; network
    (allow process self (tcp_socket ( listen )))

    (allow process node_t (tcp_socket ( node_bind )))

    (allow process node_t (udp_socket ( node_bind )))

    (typeattribute non_reserved_port_type)

    (typeattributeset non_reserved_port_type
      (and (port_type)
          (not ( reserved_port_t hi_reserved_port_t ssh_port_t ftp_port_t smtp_port_t)))
    )

    (allow process non_reserved_port_type (tcp_socket (name_connect name_bind)))

    ;; private tmpfs
    (type idea_tmpfs_t)
 
    (call gui_tmpfs_access ( process idea_tmpfs_t ))

    (allow process idea_tmpfs_t ( file ( read getattr write map )))

    ;; wayland
    (typeattributeset wayland_client (process))

    (call restrict_data_access ( idea_data_t process restricted_idea ))
)
