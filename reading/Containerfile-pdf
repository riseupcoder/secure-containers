# ---- Stage 1: build hardened_malloc from source ----
FROM alpine:latest AS builder

RUN apk add --no-cache git clang22 g++ make

RUN git clone --depth=1 https://github.com/GrapheneOS/hardened_malloc \
    && cd hardened_malloc \
    && make VARIANT=default \
    && install -m 755 out/libhardened_malloc.so /usr/lib/

# ---- Stage 2: runtime ----
FROM alpine:latest

COPY --from=builder /usr/lib/libhardened_malloc.so /usr/lib/

RUN apk add mesa-dri-gallium nnn imv-wayland papers xdg-utils font-carlito

# System-wide preload via ENV (applies to ALL processes in the container)
ENV LD_PRELOAD=/usr/lib/libhardened_malloc.so

# Also set in /etc/profile for interactive login shells
RUN echo 'export LD_PRELOAD=/usr/lib/libhardened_malloc.so' >> /etc/profile

# Upgrade packages
ARG CACHE_BUST=1
RUN apk upgrade

RUN fc-cache -fv

# Non-root user
ARG UID=1000
ARG GID=1000

RUN addgroup -g "$GID" user 2>/dev/null || true && \
    adduser -u "$UID" -g "$GID" -D -S -h /home/user user

RUN mkdir -p /home/user/.config && \
    cat > /home/user/.config/mimeapps.list <<'EOF'
[Default Applications]
image/jpeg=imv.desktop
image/png=imv.desktop
image/gif=imv.desktop
image/webp=imv.desktop
EOF

RUN chown -R user:user /home/user

USER user
WORKDIR /home/user
