(block selinux-mullvadbrowser
    (blockinherit container)

    (allow process mullvadbrowser_data_t ( dir ( add_name create getattr open read remove_name rmdir search setattr write ))) 
    (allow process mullvadbrowser_data_t ( file ( append create getattr lock map open read rename setattr unlink write ))) 

    (allow user_t mullvadbrowser_data_t ( dir ( add_name create getattr open read remove_name rmdir search setattr write ))) 
    (allow user_t mullvadbrowser_data_t ( file ( append create getattr map open read rename setattr unlink write ))) 

    (allow process mullvadbrowser_data_t ( lnk_file ( create read unlink )))
 
    (allow process user_tmp_t
      (file (map)))

    (allow process tmpfs_t
      (file (map)))

    (allow process http_port_t
      ( tcp_socket ( name_connect )))

    (allow process container_file_t ( dir ( getattr open read search ))) 
    (allow process container_file_t ( file ( getattr open read ))) 

    (allow process user_t
      (unix_stream_socket (connectto)))

    (call restrict_data_access(mullvadbrowser_data_t process restricted_mullvadbrowser))
)
