(block selinux-chromium
    (blockinherit container)

    ;; process
    (allow process chromium_data_t ( dir ( add_name create getattr open read remove_name rename rmdir search setattr write reparent watch ))) 

    (allow process chromium_data_t ( file ( append create getattr ioctl lock map open read rename setattr unlink write ))) 

    (allow process chromium_data_t ( lnk_file ( create read unlink )))

    ;; user_t
    (allow user_t chromium_data_t 
      (dir (add_name create getattr open read remove_name rmdir search setattr write))) 

    (allow user_t chromium_data_t 
      (file (append create getattr open read rename setattr unlink write))) 

    (allow user_t chromium_data_t ( lnk_file ( unlink )))

    ;; network
    (allow process http_port_t ( tcp_socket ( name_connect )))

    (dontaudit process self ( cap_userns ( sys_ptrace )))

    ;; audio
    (allow process user_tmp_t ( sock_file ( write )))

    (allow process user_t ( unix_stream_socket ( connectto )))

    ;; private tmpfs
    (type chromium_tmpfs_t)
 
    (call gui_tmpfs_access ( process chromium_tmpfs_t ))

    (allow process chromium_tmpfs_t ( file ( read getattr write map open )))

    ;; wayland
    (typeattributeset wayland_client (process))

    (call restrict_data_access ( chromium_data_t process restricted_chromium ))
)
