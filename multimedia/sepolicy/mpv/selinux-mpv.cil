(block selinux-mpv
    (blockinherit container)

    ;; process
    (allow process mpv_data_t ( dir ( add_name create getattr open read remove_name rmdir search setattr write watch ))) 
    (allow process mpv_data_t ( file ( append create getattr map open read rename setattr unlink write ))) 

    ;; uncomment the below code if you want to change the mpv configuration. 
    ;; Without it no user can access mpv dir except the mpv container
        
    ;; user_t
    ;; (allow user_t mpv_data_t ( dir ( add_name create getattr open read remove_name rmdir search setattr write watch ))) 
    ;; (allow user_t mpv_data_t ( file ( append create getattr map open read rename setattr unlink write ))) 

    (allow process mnt_t ( dir ( getattr open read search ))) 
    (allow process mnt_t ( file ( getattr open read ))) 
 
    ;; audio
    (allow process user_tmp_t ( sock_file ( write )))
    (allow process user_t ( unix_stream_socket ( connectto )))
 
    ;; wayland
    (typeattributeset wayland_client (process))
    
    (call restrict_data_access(mpv_data_t process restrict_mpv))
)
