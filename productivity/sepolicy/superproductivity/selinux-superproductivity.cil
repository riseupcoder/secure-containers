(block selinux-superproductivity
    (blockinherit container)

    ;; process
    (allow process superproductivity_data_t ( dir ( add_name create getattr open read remove_name rmdir search setattr write ))) 

    (allow process superproductivity_data_t ( file ( append create getattr lock map open read rename setattr unlink write ))) 

    (allow process superproductivity_data_t ( lnk_file ( create read unlink )))

    ;; user_t
    (allow user_t superproductivity_data_t ( dir ( add_name getattr open read search write rmdir remove_name setattr ))) 

    (allow user_t superproductivity_data_t ( file ( getattr create open read write rename setattr unlink ))) 

    ;; audio
    (allow process user_tmp_t ( sock_file ( write )))
    (allow process user_t ( unix_stream_socket ( connectto )))

    ;; private tmpfs
    (type superproductivity_tmpfs_t)
 
    (call gui_tmpfs_access ( process superproductivity_tmpfs_t ))

    (allow process superproductivity_tmpfs_t ( file ( read getattr write map )))

    ;; wayland
    (typeattributeset wayland_client (process))

    (call restrict_data_access (superproductivity_data_t process restrict_superproductivity))
)
